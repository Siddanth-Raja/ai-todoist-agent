# Existing Google Calendar OAuth configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Personal Gmail may reuse the Desktop client above or use a separate client.
PERSONAL_EMAIL_GOOGLE_CLIENT_ID=
PERSONAL_EMAIL_GOOGLE_CLIENT_SECRET=

# Generated only by scripts/personal_email_oauth_setup.py.
PERSONAL_EMAIL_GOOGLE_REFRESH_TOKEN=

# Optional wrong-account guard. Keep the literal address only in ignored backend/.env.
PERSONAL_EMAIL_EXPECTED_ADDRESS=
